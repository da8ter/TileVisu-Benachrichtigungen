{
    "elements": [
        { "type": "Label", "caption": "Scripts and modules send messages with NTF_Send. The tile lists them and can show new ones as an overlay above the whole visualization." },
        {
            "type": "ExpansionPanel",
            "caption": "Overlay",
            "expanded": true,
            "items": [
                { "type": "CheckBox", "name": "OverlayDefault", "caption": "Show new messages as overlay (unless the message says otherwise)" },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "NumberSpinner", "name": "DefaultDuration", "caption": "Close after (0 = stays open)", "suffix": " s", "minimum": 0, "maximum": 86400 },
                        {
                            "type": "Select",
                            "name": "DefaultSize",
                            "caption": "Size",
                            "options": [
                                { "caption": "Small", "value": "small" },
                                { "caption": "Medium", "value": "medium" },
                                { "caption": "Large", "value": "large" },
                                { "caption": "Full screen", "value": "full" }
                            ]
                        }
                    ]
                },
                { "type": "CheckBox", "name": "OverlayEverywhere", "caption": "Show overlay on every page" },
                { "type": "Label", "caption": "Off: the overlay appears only while the page with this tile is open. On: it appears on every page of the browser visualization as soon as the tile was loaded once (for example on the start page). The Symcon app shows the overlay inside the tile only." },
                { "type": "NumberSpinner", "name": "PollInterval", "caption": "Check interval (every page)", "suffix": " s", "minimum": 1, "maximum": 60 }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "List",
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "NumberSpinner", "name": "MaxMessages", "caption": "Keep at most", "suffix": " messages", "minimum": 1, "maximum": 500 },
                        { "type": "NumberSpinner", "name": "MaxAgeDays", "caption": "Delete after (0 = never)", "suffix": " days", "minimum": 0, "maximum": 3650 }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "RowLayout",
            "items": [
                { "type": "Button", "caption": "Send test message", "onClick": "NTF_SendTest($id);" },
                { "type": "Button", "caption": "Delete all messages", "onClick": "NTF_Clear($id);", "confirm": "Delete all messages?" }
            ]
        },
        { "type": "Label", "caption": "Example: NTF_Send(12345, 'Water alarm', 'Basement', '{\"template\":\"alarm\"}');" },
        { "type": "Label", "caption": "Options (JSON, all optional): template (alarm, warning, info, success, doorbell, reminder), icon, image (URL, media ID or data URI), sound (ID of a sound media object), html, level (info, success, warning, alarm), overlay (true/false), duration (seconds, 0 = stays open), size (small, medium, large, full or {\"width\":\"600px\",\"height\":\"70vh\"}), layout (card, banner, hero, toast, photo), id (same id replaces the message)." }
    ]
}
